[13.600202, "o", "d\bdatabase\u001b[?2004l\r\r\n"]
[14.024173, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\ninsert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\nselect from <имя_таблицы> [where <столбец> = <значение>] - прочитать записи\r\nupdate <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\ninfo <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная ин"]
[14.02426, "o", "формация\r\n\r\n>>>Введите команду: "]
[14.706037, "o", "create_table users name:str age:int is_active:bool\r\n"]
[14.710217, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[14.710519, "o", ">>>Введите команду: "]
[15.811875, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[15.812524, "o", "Функция insert выполнилась за 0.000 секунд.\r\n"]
[15.813558, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[15.813676, "o", ">>>Введите команду: "]
[16.916988, "o", "select from users where age = 28\r\n"]
[16.91757, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[17.204588, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[17.204722, "o", ">>>Введите команду: "]
[18.021822, "o", "select from users where age = 28\r\n"]
[18.022629, "o", "Результат получен из кэша.\r\nФункция select выполнилась за 0.000 секунд.\r\n"]
[18.023036, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[18.023196, "o", ">>>Введите команду: "]
[29.068314, "o", "insert into users values (\"Ann\", \"28\", false)\r\n"]
[29.068872, "o", "Ошибка валидации: age='28'\r\n"]
[29.068981, "o", ">>>Введите команду: "]
[30.174967, "o", "delete from users where ID = 1\r\n"]
[30.175865, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[31.278731, "o", "n\r\n"]
[31.278964, "o", "Операция отменена.\r\n"]
[31.279392, "o", ">>>Введите команду: "]
[32.38515, "o", "select from users where age = 28\r\n"]
[32.386192, "o", "Результат получен из кэша.\r\nФункция select выполнилась за 0.000 секунд.\r\n"]
[32.386713, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[32.38695, "o", ">>>Введите команду: "]
[46.590638, "o", "delete from users where ID = 1\r\n"]
[46.590912, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[47.695418, "o", "y\r\n"]
[47.696912, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[47.697098, "o", ">>>Введите команду: "]
[48.802078, "o", "select from users\r\n"]
[48.803117, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[48.803303, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n+----+------+-----+-----------+\r\n"]
[48.803463, "o", ">>>Введите команду: "]
[49.909395, "o", "drop_table users\r\n"]
[49.910334, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[51.014689, "o", "n\r\n"]
[51.014847, "o", "Операция отменена.\r\n"]
[51.015149, "o", ">>>Введите команду: "]
[52.120632, "o", "info users\r\n"]
[52.121081, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\n"]
[52.121167, "o", ">>>Введите команду: "]
[53.227825, "o", "drop_table users\r\n"]
[53.227982, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[54.33525, "o", "y\r\n"]
