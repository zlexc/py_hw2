[35.844974, "o", "d\bda"]
[35.845157, "o", "tabase\u001b[?2004l\r\r\n"]
[35.884185, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\ninsert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\nselect from <имя_таблицы> [where <столбец> = <значение>] - прочитать записи\r\nupdate <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\ninfo <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n"]
[35.88427, "o", "<command> help - справочная информация\r\n\r\n"]
[35.884324, "o", ">>>Введите команду: "]
[36.951722, "o", "select from users where age = 29\r\n"]
[36.952723, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[36.973373, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[36.973511, "o", ">>>Введите команду: "]
[38.058211, "o", "select from users where age = 29\r\n"]
[38.058999, "o", "Результат получен из кэша.\r\n"]
[38.059102, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[38.059457, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[38.059672, "o", ">>>Введите команду: "]
[39.163175, "o", "delete from users where ID = 1\r\n"]
[39.163662, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[40.270042, "o", "y\r\n"]
[40.272181, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[40.272335, "o", ">>>Введите команду: "]
[41.37404, "o", "info users\r\n"]
[41.374533, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\n"]
[41.374779, "o", ">>>Введите команду: "]
[42.47925, "o", "drop_table users\r\n"]
[42.479591, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[43.583223, "o", "y\r\n"]
[43.585367, "o", "Таблица \"users\" успешно удалена.\r\n"]
[43.585649, "o", ">>>Введите команду: "]
[44.688334, "o", "list_tables\r\nexit\r\n"]
[44.688586, "o", "Таблиц пока нет.\r\n"]
[44.688802, "o", ">>>Введите команду: "]
