[16.32971, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\ninsert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\nselect from <имя_таблицы> [where <столбец> = <значение>] - прочитать записи\r\nupdate <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\ninfo <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная ин"]
[16.329778, "o", "формация\r\n\r\n>>>Введите команду: "]
[16.567087, "o", "create_table users name:str age:int is_active:bool\r\n"]
[16.569668, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[16.56984, "o", ">>>Введите команду: "]
[17.671307, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[17.672237, "o", "Функция insert выполнилась за 0.000 секунд.\r\n"]
[17.674087, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[17.674278, "o", ">>>Введите команду: "]
[18.776373, "o", "select from users\r\n"]
[18.777257, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[19.036261, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[19.036329, "o", ">>>Введите команду: "]
[19.882196, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[19.888374, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[19.888516, "o", ">>>Введите команду: "]
[20.985543, "o", "select from users where age = 29\r\nexit\r\n"]
[20.986102, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[20.986466, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[20.986636, "o", ">>>Введите команду: "]
[20.999504, "o", "                                                                                                              \r\r"]
