[18.124253, "o", "d\bdat"]
[18.124301, "o", "abase\u001b[?2004l\r\r\n"]
[18.911251, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\ninsert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\nselect from <имя_таблицы> [where <столбец> = <значение>] - прочитать записи\r\nupdate <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\n"]
[18.911321, "o", "info <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n>>>Введите команду: "]
[19.23146, "o", "create_table users name:str age:int is_active:bool\r\n"]
[19.236243, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[19.236461, "o", ">>>Введите команду: "]
[20.335741, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[20.33886, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[20.339056, "o", ">>>Введите команду: "]
[21.441171, "o", "insert into users values (\"Ann\", 28, false)\r\n"]
[21.443945, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[21.44417, "o", ">>>Введите команду: "]
[22.546916, "o", "select from users where age = 28\r\n"]
[22.849375, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Ann   |  28 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[22.849437, "o", ">>>Введите команду: "]
[44.77256, "o", "update users set age = 29 where age = 28\r\n"]
[44.774552, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\nЗапись с ID=2 в таблице \"users\" успешно обновлена.\r\n"]
[44.774656, "o", ">>>Введите команду: "]
[45.878281, "o", "select from users\r\ninfo users\r\nexit\r\n"]
[45.879445, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n| 2  |  Ann   |  29 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[45.8796, "o", ">>>Введите команду: "]
[45.879759, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 2\r\n"]
[45.879846, "o", ">>>Введите команду: "]
[45.897506, "o", "                                                                                                              \r\r"]
[45.897661, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J$ \u001b[K\u001b[?2004h"]
[46.985378, "o", "d\bda"]
[46.985433, "o", "tabase"]
[46.985456, "o", "\u001b[?2004l\r\r\n"]
[47.026861, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\ninsert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\nselect from <имя_таблицы> [where <столбец> = <значение>] - прочитать записи\r\nupdate <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\ninfo <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная ин"]
[47.026895, "o", "формация\r\n\r\n"]
[47.027073, "o", ">>>Введите команду: "]
[48.090843, "o", "select from users\r\n"]
[48.106801, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n| 2  |  Ann   |  29 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[48.106893, "o", ">>>Введите команду: "]
[49.195999, "o", "delete from users where age = 29\r\n"]
[49.197534, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\nЗапись с ID=2 успешно удалена из таблицы \"users\".\r\n"]
[49.197636, "o", ">>>Введите команду: "]
[50.30109, "o", "info users\r\ndrop_table users\r\nexit\r\n"]
[50.301788, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\n"]
[50.301981, "o", ">>>Введите команду: "]
[50.3035, "o", "Таблица \"users\" успешно удалена.\r\n"]
[50.303597, "o", ">>>Введите команду: "]
[50.317381, "o", "                                                                                                              \r\r"]
[50.317513, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J$ \u001b[K\u001b[?2004h"]
[51.407546, "o", "e"]
[51.407628, "o", "\bexit\u001b[?2004l\r\r\n"]
