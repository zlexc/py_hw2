[31.494711, "o", "databas"]
[31.494772, "o", "e\u001b[?2004l\r\r\n"]
[32.205307, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[32.205373, "o", ">>>Введите команду: "]
[44.47272, "o", "create_table users name:str age:int is_active:bool\r\n"]
[44.4747, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[44.474815, "o", ">>>Введите команду: "]
[45.577527, "o", "list_tables\r\nexit\r\n"]
[45.578292, "o", "- users\r\n"]
[45.578425, "o", ">>>Введите команду: "]
[45.585164, "o", "%                                                                                                            \r \r"]
[45.585274, "o", "\r$ \u001b[?2004h"]
[54.965777, "o", "dat"]
[54.965811, "o", "abase\u001b[?2004l\r\r\n"]
[54.995777, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[54.995848, "o", ">>>Введите команду: "]
[56.069544, "o", "list_tables\r\ncreate_table users name:str\r\n"]
[56.069691, "o", "- users\r\n"]
[56.069974, "o", ">>>Введите команду: "]
[56.070101, "o", "Ошибка: Таблица \"users\" уже существует.\r\n>>>Введите команду: "]
[57.175766, "o", "drop_table users\r\nlist_tables\r\nexit\r\n"]
[57.177795, "o", "Таблица \"users\" успешно удалена.\r\n"]
[57.178067, "o", ">>>Введите команду: "]
[57.178222, "o", "Таблиц пока нет.\r\n"]
[57.178452, "o", ">>>Введите команду: "]
[57.185535, "o", "%                                                                                                            \r \r"]
[57.185643, "o", "\r$ \u001b[?2004h"]
[58.281145, "o", "ex"]
[58.281296, "o", "it\u001b[?2004l\r\r\n"]
